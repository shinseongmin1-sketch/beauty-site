# 테스트용 Supabase 프로젝트 (운영 DB 와 반드시 다른 프로젝트).
# 이 파일을 .env.test 로 복사해서 채운다. .env.test 는 Git 에 올라가지 않는다(.env* 무시).
# 운영 프로젝트의 값은 절대 넣지 않는다 (운영 URL 이 들어가면 스크립트가 스스로 중단한다).

# Project Settings → API(또는 Data API) → Project URL
SUPABASE_TEST_URL=https://TEST_PROJECT_REF.supabase.co
# Project Settings → API Keys → "Legacy anon, service_role API keys" 탭 (eyJ 로 시작하는 JWT 형식 키 권장)
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# 마이그레이션(DDL) 적용용 개인 액세스 토큰. 계정의 "모든" 프로젝트에 권한이 있으므로
# 파일에 저장하지 말고 터미널 세션 환경변수로 넣는 것을 권장한다:
#   PowerShell:  $env:SUPABASE_TEST_ACCESS_TOKEN = "sbp_..."
# (파일에 넣는다면 만료일을 짧게 잡은 토큰을 쓰고 테스트가 끝나면 폐기한다.)
SUPABASE_TEST_ACCESS_TOKEN=

# 백업 암호화 키(복구 드릴용): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=

# 사업자등록번호/전화번호 해시용 비밀값: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 분실/교체하면 기존 해시와 달라져 무료체험 중복 방지가 깨지므로 안전한 곳에 보관. 운영과 다른 값을 쓴다.
BUSINESS_NUMBER_PEPPER=
