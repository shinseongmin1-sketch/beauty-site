# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.test.example

# vercel
.vercel

# supabase cli local cache
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# DB 백업 산출물 (암호화되어 있어도 Git 에 올리지 않는다)
/backups/
/supabase/prod-apply/*.sql

# 화면 검증 스크린샷
/.e2e-shots/
/.e2e-downloads/
