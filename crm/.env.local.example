# Supabase 프로젝트 설정 → Project Settings → API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 관리자 작업(네이버예약 webhook 등)에만 사용, 절대 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 토스페이먼츠 예약결제(결제위젯). 비워두면 예약결제 기능이 "사용할 수 없음"으로 표시됩니다 (기본 키 없음).
# 개발/Preview 에서는 test_ 키, 운영(Vercel Production)에서는 live_ 키만 동작합니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
